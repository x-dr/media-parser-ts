# Media Parser TS 完整配置示例
# 复制为 .env 后再填写；不要提交 .env、Cookie、API Key、密码或加密密钥。

# ── Docker Compose 对外入口 ────────────────────────────────────────────────
# 使用宿主 Nginx 反向代理时只监听回环地址；仅在可信局域网直连时改为 0.0.0.0。
MEDIA_PARSER_BIND_ADDRESS=127.0.0.1
# 宿主 Nginx 转发到的端口。不会改变容器内 API 端口。
MEDIA_PARSER_PORT=8051

# ── API 基础配置 ──────────────────────────────────────────────────────────
# 直接在宿主机运行 API 时生效；Compose 内部固定使用 8051。
PORT=8051
LOG_LEVEL=info
# 宿主机开发请改为 .local/media-parser.sqlite；Compose 内固定为下列容器路径。
DATABASE_PATH=/app/data/media-parser.sqlite

# ── 解析超时与并发 ────────────────────────────────────────────────────────
# 完整解析超时：1000–120000 毫秒。
PARSE_TIMEOUT_MS=25000
# 单个上游 HTTP 请求超时：500–60000 毫秒。
UPSTREAM_TIMEOUT_MS=10000
# 全服务解析并发：1–1000。
GLOBAL_PARSE_CONCURRENCY=20

# ── 公开解析网页 ──────────────────────────────────────────────────────────
# 在管理后台创建 public-web 专用调用方后填写 mp_... Key；留空时公开页不可解析。
PUBLIC_WEB_API_KEY=
# 匿名网页独立并发：1–100。
PUBLIC_WEB_CONCURRENCY=8
# 每个可信客户端 IP 每分钟请求数：1–1000。
PUBLIC_WEB_RATE_LIMIT_PER_MINUTE=6

# ── 日志 ──────────────────────────────────────────────────────────────────
# 调用日志保留天数：1–365。
LOG_RETENTION_DAYS=30

# ── 首次管理员引导 ────────────────────────────────────────────────────────
# 仅在空数据库首次启动时使用。用户名为 3–64 位、以小写字母或数字开头。
# 其余字符可使用小写字母、数字、点、下划线或短横线。
ADMIN_BOOTSTRAP_USERNAME=admin
# Compose 会覆盖为 /run/secrets/admin_password；宿主开发改为 .local/admin-password。
ADMIN_BOOTSTRAP_PASSWORD_FILE=/run/secrets/admin_password
# Compose secret 的宿主源文件，内容必须为 12–128 个字符并保持 0600 权限。
ADMIN_BOOTSTRAP_PASSWORD_SOURCE=.local/admin-password

# ── 平台凭据加密 ──────────────────────────────────────────────────────────
# 必填：Base64 编码的 32 字节随机密钥。丢失后数据库中的平台凭据无法恢复。
APP_ENCRYPTION_KEY=
# 仅在密钥轮换期间填写旧密钥；确认所有旧凭据已重新加密后再清空。
APP_ENCRYPTION_KEY_PREVIOUS=

# ── 代理与跨域 ────────────────────────────────────────────────────────────
# 同源网页无需配置；如有独立前端，填写逗号分隔的精确 Origin，不支持 *。
CORS_ORIGINS=
# 只能是 false、可信代理跳数或逗号分隔的可信地址，不能写 true。
# 本文档的“宿主 Nginx -> Web Nginx -> API”拓扑为 2；直接访问 Compose 入口时为 1。
TRUST_PROXY=2

# ── 可选平台登录态 ────────────────────────────────────────────────────────
# 更推荐部署后从管理后台写入；数据库托管凭据优先于以下环境变量。
DOUBAO_COOKIE=
YUANBAO_COOKIE=
KUAISHOU_COOKIE=
XIAOHONGSHU_COOKIE=

# ── 解析引擎 ──────────────────────────────────────────────────────────────
# 默认使用本地 TypeScript Parser；legacy-http 仅用于整体回滚。
PARSER_ENGINE=typescript
# PARSER_ENGINE=legacy-http 时必填，必须是无用户名和密码的 HTTP(S) 根 URL。
LEGACY_PYTHON_URL=
