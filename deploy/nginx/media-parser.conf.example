# 将 media.example.com 替换为实际域名，并确认 TLS 证书路径存在。
# Compose 默认只在 127.0.0.1:8051 监听，因此本配置应与 Docker 运行在同一宿主机。

upstream media_parser {
    server 127.0.0.1:8051;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name media.example.com;

    # 如使用 certbot --webroot，请保持此目录与 certbot 的 -w 参数一致。
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 308 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name media.example.com;

    ssl_certificate /etc/letsencrypt/live/media.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/media.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:media_parser_tls:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    server_tokens off;
    client_max_body_size 32k;

    # PARSE_TIMEOUT_MS 最大为 120 秒，代理超时略高于应用上限。
    proxy_connect_timeout 5s;
    proxy_send_timeout 130s;
    proxy_read_timeout 130s;

    location / {
        proxy_pass http://media_parser;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # 覆盖客户端自带的 X-Forwarded-For；容器内 Nginx 会再追加这一代理跳。
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
    }

    add_header Strict-Transport-Security "max-age=31536000" always;
}
